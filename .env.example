# Адрес API LM Studio
LM_STUDIO_HOST=

# API-ключ: LM Studio не проверяет его, достаточно любого значения
LM_STUDIO_API_KEY=

# Тяжёлая модель (сложные задачи)
LM_STUDIO_MODEL_HEAVY=
# Лёгкая модель (простые задачи)
LM_STUDIO_MODEL_LIGHT=

# Embedding-модель для RAG (векторная память)
EMBEDDING_MODEL=

# Имя коллекции в Chroma (база знаний)
CHROMA_COLLECTION=

# Имя файла пошагового лога агента (data/<имя>)
TRACE_FILE_NAME=

# Сервис LDAP
LDAP_SERVICE_HOST=
LDAP_SERVICE_PORT=

# Сервис Exchange
EXCHANGE_SERVICE_HOST=
EXCHANGE_SERVICE_PORT=

# Сервис 1С
ONEC_SERVICE_HOST=
ONEC_SERVICE_PORT=